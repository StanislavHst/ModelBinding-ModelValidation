@model List<PriceEdit>
@{
    ViewData["Title"] = "Edit prices";
}
<h1>Edit prices for @ViewBag.Type</h1>
<form asp-action="EditPrices" asp-route-type="@ViewBag.Type" method="post">
    <div asp-validation-summary="All" class="text-danger"></div>
    @if (Model.Count == 0)
    {
        <p>There are no products in this category.</p>
    }
    else
    {
        <table class="table">
            <tr><th>Id</th><th>Name</th><th>Price</th></tr>
            @for (int i = 0; i < Model.Count; i++)
            {
                <tr>
                    <td><input name="rows[@i].Id" value="@Model[i].Id" readonly aria-label="Id" /></td>
                    <td><input value="@Model[i].Name" readonly aria-label="Name" /></td>
                    <td>@Html.TextBox($"rows[{i}].Price", Model[i].Price, new { aria_label = "Price" })</td>
                </tr>
            }
        </table>
        <button type="submit" class="btn btn-primary">Save</button>
    }
</form>
<a asp-action="Index">Back to list</a>
